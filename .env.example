# Local exact trigger; each developer sets their own app name.
TRIGGER=@bandwidth-reviewer-dev-yourname
# Local webhook signing secret; replace this only in your ignored .env.
WEBHOOK_SECRET=replace-with-your-local-app-secret
# Personal relay channel; leave empty to use direct local requests.
SMEE_URL=
# Local ingress and Moto ports (bound to localhost).
INGRESS_PORT=8000
MOTO_PORT=5001
# Optional local app configuration for the following worker milestone.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=.secrets/github-app.pem
GITHUB_API_URL=https://api.github.com
SANDBOX_REPO=rishyendra333/bandwidth-reviewer-demo
SANDBOX_PR=
# Live account configuration; normal local development does not read these credentials.
AWS_PROFILE=default
AWS_REGION=us-west-2
HOSTING_ACCOUNT_ID=516647891652
# Only enable real calls after sponsor model/region approval.
BEDROCK=fake
BEDROCK_APPROVED=false
BEDROCK_MODEL_ID=
HELP_CHANNEL=team-project-help
